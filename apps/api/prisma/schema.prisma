generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  DISABLED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  WITHDRAWN
}

enum ClassSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum PaymentRecordStatus {
  ACTIVE
  VOIDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CompensationCalculationType {
  FIXED
  PERCENTAGE
  PER_STUDENT
  HOURLY
}

enum CompensationStatus {
  DRAFT
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum GroupStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CourseStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CourseCategory {
  KIDS_PROGRAMMING
  WEB_DEVELOPMENT
  FULL_STACK
  AI_ENGINEERING
  DATA_ENGINEERING
  DESIGN
  ENGLISH
  SUPPLEMENTARY_EDUCATION
  OTHER
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
  REMINDER
}

enum EmploymentContractType {
  INDEFINITE
  FIXED_TERM
  SPECIFIC_TASK
  COLLABORATION
}

enum EmploymentContractStatus {
  DRAFT
  ISSUED
  ACTIVE
  EXPIRED
  TERMINATED
}

enum EmploymentTimeType {
  FULL_TIME
  PART_TIME
}

enum ParentRelationship {
  MOTHER
  FATHER
  GUARDIAN
  OTHER
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SUPPLIES
  MARKETING
  SOFTWARE
  SALARIES
  MAINTENANCE
  OTHER
}

enum ExpenseStatus {
  ACTIVE
  VOIDED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  PAUSED
  GRADUATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

// ---------------------------------------------------------------------------
// Auth & RBAC
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  phone        String?
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  roles               UserRole[]
  instructorProfile   Instructor?
  studentProfile      Student?
  parentProfile       Parent?
  recordedPayments    Payment[]              @relation("PaymentRecordedBy")
  recordedExpenses    Expense[]              @relation("ExpenseRecordedBy")
  notifications       Notification[]
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  employmentContracts EmploymentContract[] @relation("EmployeeContracts")
  createdContracts    EmploymentContract[] @relation("ContractCreatedBy")

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  displayName String   @map("display_name")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

model Family {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  students Student[]

  @@map("families")
}

model Student {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String?       @unique @map("user_id") @db.Uuid
  firstName        String        @map("first_name")
  lastName         String        @map("last_name")
  dateOfBirth      DateTime?     @map("date_of_birth") @db.Date
  gender           Gender?
  email            String?
  phone            String?
  address          String?
  school           String?
  notes            String?
  familyId         String?       @map("family_id") @db.Uuid
  status           StudentStatus @default(ACTIVE)
  registrationDate DateTime      @default(now()) @map("registration_date") @db.Date
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  family       Family?        @relation(fields: [familyId], references: [id], onDelete: SetNull)
  parents      StudentParent[]
  enrollments  Enrollment[]
  attendances  Attendance[]
  invoices     Invoice[]
  payments     Payment[]
  certificates Certificate[]

  @@index([lastName, firstName])
  @@index([email])
  @@index([status])
  @@index([familyId])
  @@index([deletedAt])
  @@map("students")
}

model Parent {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String?   @unique @map("user_id") @db.Uuid
  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  email     String?
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  students StudentParent[]

  @@index([lastName, firstName])
  @@index([email])
  @@index([deletedAt])
  @@map("parents")
}

model StudentParent {
  id           String             @id @default(uuid()) @db.Uuid
  studentId    String             @map("student_id") @db.Uuid
  parentId     String             @map("parent_id") @db.Uuid
  relationship ParentRelationship @default(GUARDIAN)
  isPrimary    Boolean            @default(false) @map("is_primary")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@index([parentId])
  @@map("student_parents")
}

model Instructor {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String?   @unique @map("user_id") @db.Uuid
  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  email     String    @unique
  phone     String?
  bio       String?
  hireDate  DateTime? @map("hire_date") @db.Date
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user              User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  primaryGroups     Group[]                     @relation("GroupPrimaryInstructor")
  compensationRules InstructorCompensationRule[]
  compensations     InstructorCompensation[]

  @@index([lastName, firstName])
  @@index([deletedAt])
  @@map("instructors")
}

// ---------------------------------------------------------------------------
// Academics
// ---------------------------------------------------------------------------

model Course {
  id                  String         @id @default(uuid()) @db.Uuid
  code                String         @unique
  name                String
  description         String?
  category            CourseCategory @default(OTHER)
  ageMin              Int?           @map("age_min")
  ageMax              Int?           @map("age_max")
  durationMonths      Int?           @map("duration_months")
  defaultMonthlyPrice Decimal?       @map("default_monthly_price") @db.Decimal(12, 2)
  status              CourseStatus   @default(DRAFT)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  deletedAt           DateTime?      @map("deleted_at")

  groups            Group[]
  certificates      Certificate[]
  compensationRules InstructorCompensationRule[]

  @@index([status])
  @@index([category])
  @@index([deletedAt])
  @@map("courses")
}

model Group {
  id           String      @id @default(uuid()) @db.Uuid
  courseId     String      @map("course_id") @db.Uuid
  instructorId String?     @map("primary_instructor_id") @db.Uuid
  name         String
  capacity     Int?
  room         String?
  startDate    DateTime?   @map("start_date") @db.Date
  endDate      DateTime?   @map("end_date") @db.Date
  status       GroupStatus @default(PLANNED)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  deletedAt    DateTime?   @map("deleted_at")

  course            Course                   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  instructor        Instructor?              @relation("GroupPrimaryInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  schedules         GroupSchedule[]
  enrollments       Enrollment[]
  classSessions     ClassSession[]
  compensationRules InstructorCompensationRule[]
  compensations     InstructorCompensation[]

  @@index([courseId])
  @@index([instructorId])
  @@index([status])
  @@index([deletedAt])
  @@map("groups")
}

model GroupSchedule {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  dayOfWeek Int      @map("day_of_week")
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, dayOfWeek, startTime, endTime])
  @@index([groupId])
  @@map("group_schedules")
}

model Enrollment {
  id                 String           @id @default(uuid()) @db.Uuid
  studentId          String           @map("student_id") @db.Uuid
  groupId            String           @map("group_id") @db.Uuid
  discountId         String?          @map("discount_id") @db.Uuid
  startDate          DateTime         @map("start_date") @db.Date
  endDate            DateTime?        @map("end_date") @db.Date
  status             EnrollmentStatus @default(PENDING)
  agreedMonthlyPrice Decimal          @map("agreed_monthly_price") @db.Decimal(12, 2)
  discountAmount     Decimal          @default(0) @map("discount_amount") @db.Decimal(12, 2)
  billingEnabled     Boolean          @default(true) @map("billing_enabled")
  notes              String?
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  deletedAt          DateTime?        @map("deleted_at")

  student  Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  discount Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([groupId])
  @@index([status])
  @@index([deletedAt])
  @@map("enrollments")
}

model ClassSession {
  id                    String             @id @default(uuid()) @db.Uuid
  groupId               String             @map("group_id") @db.Uuid
  sessionDate           DateTime           @map("session_date") @db.Date
  startTime             String             @map("start_time")
  endTime               String             @map("end_time")
  status                ClassSessionStatus @default(SCHEDULED)
  notes                 String?
  attendanceSubmittedAt DateTime?          @map("attendance_submitted_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@unique([groupId, sessionDate, startTime])
  @@index([groupId, sessionDate])
  @@index([status])
  @@map("class_sessions")
}

model Attendance {
  id             String           @id @default(uuid()) @db.Uuid
  classSessionId String           @map("class_session_id") @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  status         AttendanceStatus @default(ABSENT)
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classSessionId, studentId])
  @@index([studentId])
  @@index([status])
  @@map("attendances")
}

// ---------------------------------------------------------------------------
// Finance
// ---------------------------------------------------------------------------

model Discount {
  id          String       @id @default(uuid()) @db.Uuid
  code        String?      @unique
  name        String
  type        DiscountType
  value       Decimal      @db.Decimal(12, 2)
  description String?
  validFrom   DateTime?    @map("valid_from")
  validUntil  DateTime?    @map("valid_until")
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  enrollments Enrollment[]

  @@index([isActive])
  @@index([deletedAt])
  @@map("discounts")
}

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  studentId       String        @map("student_id") @db.Uuid
  invoiceNumber   String        @unique @map("invoice_number")
  issueDate       DateTime      @map("issue_date") @db.Date
  dueDate         DateTime      @map("due_date") @db.Date
  billingPeriod   String        @map("billing_period")
  subtotal        Decimal       @db.Decimal(12, 2)
  discount        Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  paidAmount      Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
  remainingAmount Decimal       @map("remaining_amount") @db.Decimal(12, 2)
  status          InvoiceStatus @default(DRAFT)
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  student  Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  items    InvoiceItem[]
  payments Payment[]

  @@index([studentId])
  @@index([status])
  @@index([dueDate])
  @@index([deletedAt])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  description String
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  studentId    String        @map("student_id") @db.Uuid
  invoiceId    String?       @map("invoice_id") @db.Uuid
  recordedById String        @map("recorded_by_id") @db.Uuid
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod
  paymentDate  DateTime      @map("payment_date") @db.Date
  status       PaymentRecordStatus @default(ACTIVE)
  voidedAt     DateTime?     @map("voided_at")
  fiscalCoupon String?       @unique @map("fiscal_coupon")
  reference    String?
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  student    Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  invoice    Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  recordedBy User     @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@index([invoiceId])
  @@index([paymentDate])
  @@index([deletedAt])
  @@map("payments")
}

model InstructorCompensationRule {
  id               String                       @id @default(uuid()) @db.Uuid
  instructorId     String                       @map("instructor_id") @db.Uuid
  courseId         String?                      @map("course_id") @db.Uuid
  groupId          String?                      @map("group_id") @db.Uuid
  type             CompensationCalculationType
  percentage       Decimal?                     @db.Decimal(5, 2)
  fixedAmount      Decimal?                     @map("fixed_amount") @db.Decimal(12, 2)
  amountPerStudent Decimal?                     @map("amount_per_student") @db.Decimal(12, 2)
  hourlyRate       Decimal?                     @map("hourly_rate") @db.Decimal(12, 2)
  effectiveFrom    DateTime                     @map("effective_from") @db.Date
  effectiveUntil   DateTime?                    @map("effective_until") @db.Date
  createdAt        DateTime                     @default(now()) @map("created_at")
  updatedAt        DateTime                     @updatedAt @map("updated_at")
  deletedAt        DateTime?                    @map("deleted_at")

  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  course     Course?    @relation(fields: [courseId], references: [id], onDelete: SetNull)
  group      Group?     @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([instructorId])
  @@index([courseId])
  @@index([groupId])
  @@index([effectiveFrom, effectiveUntil])
  @@index([deletedAt])
  @@map("instructor_compensation_rules")
}

model InstructorCompensation {
  id               String                       @id @default(uuid()) @db.Uuid
  instructorId     String                       @map("instructor_id") @db.Uuid
  groupId          String                       @map("group_id") @db.Uuid
  period           String
  periodStart      DateTime                     @map("period_start") @db.Date
  periodEnd        DateTime                     @map("period_end") @db.Date
  studentCount     Int                          @default(0) @map("student_count")
  hoursTaught      Decimal                      @default(0) @map("hours_taught") @db.Decimal(8, 2)
  grossRevenue     Decimal                      @default(0) @map("gross_revenue") @db.Decimal(12, 2)
  calculationType  CompensationCalculationType  @map("calculation_type")
  percentage       Decimal?                     @db.Decimal(5, 2)
  fixedAmount      Decimal?                     @map("fixed_amount") @db.Decimal(12, 2)
  amountPerStudent Decimal?                     @map("amount_per_student") @db.Decimal(12, 2)
  hourlyRate       Decimal?                     @map("hourly_rate") @db.Decimal(12, 2)
  calculatedAmount Decimal                      @map("calculated_amount") @db.Decimal(12, 2)
  adjustments      Decimal                      @default(0) @db.Decimal(12, 2)
  adjustmentReason String?                      @map("adjustment_reason")
  finalAmount      Decimal                      @map("final_amount") @db.Decimal(12, 2)
  status           CompensationStatus           @default(DRAFT)
  notes            String?
  createdAt        DateTime                     @default(now()) @map("created_at")
  updatedAt        DateTime                     @updatedAt @map("updated_at")

  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  group      Group      @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@unique([instructorId, groupId, period])
  @@index([instructorId, period])
  @@index([groupId])
  @@index([status])
  @@map("instructor_compensations")
}

model Expense {
  id            String          @id @default(uuid()) @db.Uuid
  recordedById  String          @map("recorded_by_id") @db.Uuid
  category      ExpenseCategory
  description   String
  amount        Decimal         @db.Decimal(12, 2)
  expenseDate   DateTime        @map("expense_date") @db.Date
  paymentMethod PaymentMethod?  @map("payment_method")
  reference     String?
  notes         String?
  status        ExpenseStatus   @default(ACTIVE)
  voidedAt      DateTime?       @map("voided_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")

  recordedBy User @relation("ExpenseRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([category])
  @@index([expenseDate])
  @@index([status])
  @@index([deletedAt])
  @@map("expenses")
}

model EmploymentContract {
  id                         String                    @id @default(uuid()) @db.Uuid
  contractNumber             String                    @unique @map("contract_number")
  employeeUserId             String                    @map("employee_user_id") @db.Uuid
  createdById                String                    @map("created_by_id") @db.Uuid
  type                       EmploymentContractType
  status                     EmploymentContractStatus  @default(DRAFT)
  timeType                   EmploymentTimeType        @default(FULL_TIME) @map("time_type")
  employerName               String                    @map("employer_name")
  employerSeat               String                    @map("employer_seat")
  employerRegistrationNumber String                    @map("employer_registration_number")
  employeeFirstName          String                    @map("employee_first_name")
  employeeLastName           String                    @map("employee_last_name")
  employeeQualification      String                    @map("employee_qualification")
  employeeResidence          String                    @map("employee_residence")
  employeePersonalNumber     String?                   @map("employee_personal_number")
  jobTitle                   String                    @map("job_title")
  jobNature                  String                    @map("job_nature")
  jobDescription             String                    @map("job_description")
  workplace                  String
  workInMultipleLocations    Boolean                   @default(false) @map("work_in_multiple_locations")
  weeklyHours                Int                       @map("weekly_hours")
  workSchedule               String                    @map("work_schedule")
  startDate                  DateTime                  @map("start_date") @db.Date
  endDate                    DateTime?                 @map("end_date") @db.Date
  baseSalary                 Decimal                   @map("base_salary") @db.Decimal(12, 2)
  collaborationPercentage    Decimal?                  @map("collaboration_percentage") @db.Decimal(5, 2)
  percentageBase             String?                   @map("percentage_base")
  allowances                 String?
  paymentDay                 Int?                      @map("payment_day")
  annualLeaveDays            Int                       @default(20) @map("annual_leave_days")
  noticePeriodDays           Int                       @map("notice_period_days")
  terminationTerms           String?                   @map("termination_terms")
  probationMonths            Int                       @default(0) @map("probation_months")
  agreedTerms                String?                   @map("agreed_terms")
  notes                      String?
  issuedAt                   DateTime?                 @map("issued_at")
  signedAt                   DateTime?                 @map("signed_at")
  terminatedAt               DateTime?                 @map("terminated_at")
  createdAt                  DateTime                  @default(now()) @map("created_at")
  updatedAt                  DateTime                  @updatedAt @map("updated_at")
  deletedAt                  DateTime?                 @map("deleted_at")

  employee  User @relation("EmployeeContracts", fields: [employeeUserId], references: [id], onDelete: Restrict)
  createdBy User @relation("ContractCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([employeeUserId])
  @@index([status])
  @@index([type])
  @@index([deletedAt])
  @@map("employment_contracts")
}

// ---------------------------------------------------------------------------
// Certificates, notifications, audit
// ---------------------------------------------------------------------------

model Certificate {
  id                 String   @id @default(uuid()) @db.Uuid
  studentId          String   @map("student_id") @db.Uuid
  courseId           String   @map("course_id") @db.Uuid
  certificateCode    String   @unique @map("certificate_code")
  qrVerificationId   String?  @unique @map("qr_verification_id")
  issuedDate         DateTime @map("issued_date") @db.Date
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@index([courseId])
  @@map("certificates")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType @default(INFO)
  title     String
  message   String
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String   @map("entity_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemSettings {
  id                          String   @id @db.Uuid
  schoolName                  String   @map("school_name")
  currency                    String   @default("EUR")
  email                       String?
  phone                       String?
  address                     String?
  multiCourseDiscountPercent  Decimal  @default(10) @map("multi_course_discount_percent") @db.Decimal(5, 2)
  familyPackDiscountPercent   Decimal  @default(10) @map("family_pack_discount_percent") @db.Decimal(5, 2)
  invoiceDueDay               Int      @default(10) @map("invoice_due_day")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
