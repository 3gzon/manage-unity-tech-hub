# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://uth:uthpass@127.0.0.1:5432/unity_tech_hub?schema=public"

# CORS
WEB_ORIGIN=http://localhost:3000

# JWT
JWT_ACCESS_SECRET=change-me-use-a-long-random-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seed
SEED_SUPER_ADMIN_EMAIL=superadmin@unitytechhub.com
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin123!
SEED_ADMIN_EMAIL=admin@unitytechhub.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_INSTRUCTOR_EMAIL=instructor@unitytechhub.com
SEED_INSTRUCTOR_PASSWORD=Instructor123!
